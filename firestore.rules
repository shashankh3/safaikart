rules_version = '2';

// SafaiKart Unified Firestore Rules (Android App + Admin Console)
//
// Principles:
//   * Direct client writes to `orders` and `payments` are BLOCKED (except creation of order drafts).
//     All state changes go through Cloud Functions callables so notifications, audit logs, and pricing checks stay authoritative.
//   * Admin-only collections require a document in `adminUsers/{uid}`.
//   * `superadmin` role has full write access to admin-only surfaces.
//   * Other roles are gated by narrower rules below.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    function adminRole() {
      return get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role;
    }
    function isSuperAdmin() {
      return isAdmin() && adminRole() == 'superadmin';
    }
    function hasAnyAdminRole(roles) {
      return isAdmin() && (adminRole() in roles);
    }
    function affectsOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }
    // Limit document size to prevent abuse (max 500 KB)
    function isReasonableSize() {
      return request.resource.size() < 500 * 1024;
    }

    // --- adminUsers ------------------------------------------------------
    match /adminUsers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isSuperAdmin();
    }

    // --- users (core auth mapping) ---------------------------------------
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false; // written by auth trigger only

      match /cartItems/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- profiles (customer profiles) ------------------------------------
    match /profiles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow update: if (isOwner(uid) && affectsOnly(['displayName', 'name', 'phoneNumber', 'phone', 'photoURL', 'defaultAddressId', 'email', 'updatedAt'])) 
                    || hasAnyAdminRole(['superadmin', 'admin', 'support']);
      allow create: if isOwner(uid);
      allow delete: if false;
    }

    // --- addresses -------------------------------------------------------
    match /addresses/{addressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'line1', 'pincode'])
                    && request.resource.data.line1 is string
                    && request.resource.data.pincode is string
                    && request.resource.data.pincode.size() == 6;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- carts -----------------------------------------------------------
    match /carts/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && request.resource.data.items.size() <= 50;
    }

    // --- catalog (publicly readable, admin-writable) --------------------
    match /categories/{id} {
      allow read: if true;
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /services/{id} {
      allow read: if true;
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /zones/{id} {
      allow read: if true;
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /coupons/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.isActive == true);
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /pickupSlots/{id} {
      allow read: if true;
      allow write: if hasAnyAdminRole(['superadmin', 'admin', 'ops']);
    }

    // --- orders ---------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if false;
      allow update, delete: if false;

      // Nested logs for order history (audit trail)
      match /logs/{logId} {
        allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId);
        allow write: if false; // written by Cloud Functions only
      }
    }

    // --- payments -------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow write: if false; // Cloud Function only (e.g., Razorpay webhook)
    }

    // --- finance --------------------------------------------------------
    match /expenses/{id} {
      allow read, write: if hasAnyAdminRole(['superadmin', 'admin', 'finance']);
    }

    // --- ops and support ------------------------------------------------
    match /drivers/{id} {
      allow read: if isAdmin();
      allow write: if hasAnyAdminRole(['superadmin', 'admin', 'ops']);
    }
    match /issues/{issueId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'subject', 'description'])
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 200;
      allow update: if hasAnyAdminRole(['superadmin', 'admin', 'support', 'ops']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/issues/$(issueId)).data.userId);
        allow create: if (isSignedIn() && isOwner(get(/databases/$(database)/documents/issues/$(issueId)).data.userId)) || hasAnyAdminRole(['superadmin', 'admin', 'support', 'ops']);
        allow update, delete: if false;
      }
    }
    
    // --- marketing and social -------------------------------------------
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if hasAnyAdminRole(['superadmin', 'admin']);
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if hasAnyAdminRole(['superadmin', 'admin', 'support']);
    }

    // --- audit + config -------------------------------------------------
    match /auditLogs/{id} {
      allow read: if hasAnyAdminRole(['superadmin', 'admin']);
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }
    match /appConfig/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- webhooks (idempotency tracking) --------------------------------
    match /webhookEvents/{id} {
      allow read, write: if false; // Internal to Cloud Functions only
    }

    // --- dead letters (DLQ) ---------------------------------------------
    match /deadLetters/{id} {
      allow read: if hasAnyAdminRole(['superadmin', 'admin']);
      allow write: if false; // Cloud Functions only
    }
    
    // --- notifications --------------------------------------------------
    match /notifications/{id} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false; // Only Cloud Functions can create/update notifications
    }
    match /rateLimits/{id} {
      allow read, write: if false; // Internal to Cloud Functions
    }
    // --- fcmTokens ------------------------------------------------------
    match /fcmTokens/{id} {
      allow read, write: if false; // Cloud Functions only
    }

    // --- referrals ------------------------------------------------------
    match /referrals/{id} {
      allow read: if isAdmin() || isOwner(resource.data.referrerId) || isOwner(resource.data.referredId);
      allow write: if false; // Cloud Functions only
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
